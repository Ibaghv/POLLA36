# --------------------------------------------------
# MOVIMIENTO Y CÁMARA DEL JUEGO 2D LATERAL
# --------------------------------------------------

def movimiento(jugador_x, jugador_y, velocidad, velocidad_salto,
               gravedad, suelo_y, saltar):

    teclas = pygame.key.get_pressed()

    # Caminar a izquierda y derecha
    if teclas[pygame.K_a]:
        jugador_x -= velocidad

    if teclas[pygame.K_d]:
        jugador_x += velocidad

    # No salir por los lados del mundo
    if jugador_x < 0:
        jugador_x = 0
    if jugador_x > ancho_mundo - 40:
        jugador_x = ancho_mundo - 40

    # Saltar solo cuando el jugador está en el suelo
    jugador_en_suelo = jugador_y >= suelo_y - 50

    if saltar and jugador_en_suelo:
        velocidad_salto = -12

    # Aplicar gravedad
    jugador_y += velocidad_salto
    velocidad_salto += gravedad

    # Mantener al jugador sobre el suelo
    if jugador_y > suelo_y - 50:
        jugador_y = suelo_y - 50
        velocidad_salto = 0

    return jugador_x, jugador_y, velocidad_salto


def actualizar_camara(jugador_x, ancho_mundo):
    camara_x = jugador_x - ANCHO // 2

    if camara_x < 0:
        camara_x = 0

    if camara_x > ancho_mundo - ANCHO:
        camara_x = ancho_mundo - ANCHO

    return camara_x


def dibujar_juego(jugador_x, jugador_y, camara_x):
