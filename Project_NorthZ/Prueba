# Busca los recursos por nombre, aunque cambie la carpeta o falten tildes/espacios.
CARPETA_CODIGO = Path(__file__).resolve().parent
CARPETA_PROYECTO = (CARPETA_CODIGO / "Project_NorthZ" if (CARPETA_CODIGO / "Project_NorthZ").is_dir()
                    else CARPETA_CODIGO if CARPETA_CODIGO.name.lower() == "project_northz"
                    else Path.cwd() / "Project_NorthZ" if (Path.cwd() / "Project_NorthZ").is_dir()
                    else CARPETA_CODIGO)


def normalizar(nombre):
    nombre = unicodedata.normalize("NFD", nombre.lower())
    nombre = "".join(c for c in nombre if unicodedata.category(c) != "Mn")
    return "".join(c for c in nombre if c.isalnum())


ARCHIVOS_PROYECTO = None


def buscar_recurso(nombre):
    global ARCHIVOS_PROYECTO
    buscado = Path(nombre).name

    # Indexa las carpetas una sola vez para no ralentizar el juego.
    if ARCHIVOS_PROYECTO is None:
        raices = []
        for raiz in (CARPETA_PROYECTO, CARPETA_CODIGO, Path.cwd(), Path.cwd() / "Project_NorthZ"):
            if raiz.is_dir() and raiz not in raices:
                raices.append(raiz)
        ARCHIVOS_PROYECTO = []
        vistos = set()
        for raiz in raices:
            try:
                for archivo in raiz.rglob("*"):
                    if archivo.is_file() and archivo not in vistos:
                        vistos.add(archivo)
                        ARCHIVOS_PROYECTO.append(archivo)
            except (PermissionError, OSError):
                pass

    archivos = ARCHIVOS_PROYECTO
    clave = normalizar(buscado)
    coincidencias = [p for p in archivos if normalizar(p.name) == clave]
    if coincidencias:
        return coincidencias[0]

    # Si la extensión cambió (por ejemplo .jpg por .png), busca el mismo nombre base.
    base = normalizar(Path(buscado).stem)
    coincidencias = [p for p in archivos if normalizar(p.stem) == base]
    if len(coincidencias) == 1:
        return coincidencias[0]

    nombres = list(dict.fromkeys(p.name for p in archivos))
    sugerencias = get_close_matches(buscado, nombres, n=5, cutoff=0.45)
    detalle = "\nArchivos parecidos encontrados: " + ", ".join(sugerencias) if sugerencias else ""
    raise FileNotFoundError(f"No encuentro '{buscado}'.\nCarpeta del proyecto buscada: {CARPETA_PROYECTO}{detalle}\nRevisa que el archivo exista y que su nombre esté escrito correctamente.")


def cargar_imagen(nombre):
    return pygame.image.load(str(buscar_recurso(nombre)))


def cargar_audio(nombre):
    return pygame.mixer.Sound(str(buscar_recurso(nombre)))


