    )
    pygame.draw.rect(
        ventana,
        (95, 105, 85),
        (2600 - camara_x, 430, 300, 220)
    )

    # Suelo del mundo
    pygame.draw.rect(
        ventana,
        (80, 55, 40),
        (0 - camara_x, suelo_y, ancho_mundo, ALTO - suelo_y)
    )

