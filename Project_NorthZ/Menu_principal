import pygame
pygame.init()

ventana=pygame.display.set_mode((1500, 750))#ancho--alto

def imagen():
    Menu_carga=pygame.image.load("Project_NorthZ/Menu_carga_prueba.jpeg")
    Menu_Principal=pygame.image.load("Project_NorthZ/Menu_Principal.png")
    Enpezar_Menu=pygame.image.load("Project_NorthZ/Enpezar_Menu_carga.png")
    Menu_carga=pygame.transform.scale(Menu_carga,(1500, 750))
    Menu_Principal=pygame.transform.scale(Menu_Principal,(1500, 750))
    Enpezar_Menu=pygame.transform.scale(Enpezar_Menu,(700, 80))

    return Menu_carga, Menu_Principal, Enpezar_Menu
    
Menu_carga, Menu_Principal, Enpezar_Menu=imagen()
jugando=True
while jugando:
    #1.Comprobar_loque_hace_el_jugador
    for evento in pygame.event.get():
        if evento.type==pygame.QUIT:#si da a la X se cierrra
            jugando=False
    # 2.Actualizar_el_juego
    # aquí.irá_el_movimiento_enemigos..

    # 3.Dibujar_las_cosas
    # aquí.dibujaremos_imágenes_personajes_fondo...
    ventana.blit(Menu_carga,(0,0))
    ventana.blit(Enpezar_Menu,(350,600))
    # 4. Actualizar la pantalla
    pygame.display.update()
pygame.quit()#final del juego
