def rect_boton(imagenes):
    rect_botonEM=imagenes["botones"]["empezar"].get_rect()#Crear un rectangulo para que se pueda clickear
    rect_botonEM.topleft=(400,592)#Tamaño de zona que se puede clickear
    rect_botonNP=imagenes["botones"]["NP"].get_rect()
    rect_botonNP.topleft=(72,351)
    rect_botonC=imagenes["botones"]["C"].get_rect()
    rect_botonC.topleft=(72,488)   
    rect_botonT=imagenes["botones"]["T"].get_rect()
    rect_botonT.topleft=(72,426)
    rect_botonCr=imagenes["botones"]["Cr"].get_rect()
    rect_botonCr.topleft=(68,544)
    rect_botonS=imagenes["botones"]["S"].get_rect()
    rect_botonS.topleft=(72,604)
    
    return{
        "clickeable_AL":{
            "Rb_EM":rect_botonEM,
            "Rb_NP":rect_botonNP,
            "Rb_C":rect_botonC,
            "Rb_T":rect_botonT,
            "Rb_Cr":rect_botonCr,
            "Rb_S":rect_botonS}
    }

