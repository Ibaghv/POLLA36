def rect_boton(Enpezar_Menu, Nueva_partida, Controles, Tutorial, Creditos, Salir):
    rect_botonEM=Enpezar_Menu.get_rect()#Crear un rectangulo para que se pueda clickear
    rect_botonEM.topleft=(400,592)#Tamaño de zona que se puede clickear
    rect_botonNP=Nueva_partida.get_rect()
    rect_botonNP.topleft=(72,351)
    rect_botonC=Controles.get_rect()
    rect_botonC.topleft=(72,488)   
    rect_botonT=Tutorial.get_rect()
    rect_botonT.topleft=(72,426)
    rect_botonCr=Creditos.get_rect()
    rect_botonCr.topleft=(68,544)
    rect_botonS=Salir.get_rect()
    rect_botonS.topleft=(72,604)
    
    return rect_botonEM, rect_botonNP, rect_botonC, rect_botonT, rect_botonCr, rect_botonS

def dibujar_pantalla(pantalla_actual, Menu_carga, Menu_Principal, Enpezar_Menu, Nueva_partida, 
                     Controles, Tutorial, Creditos, Salir, Nueva_partidaA, ControlesA, TutorialA, 
                     CreditosA, SalirA, jugando, rect_botonNP, rect_botonC, rect_botonT, rect_botonCr, 
                     rect_botonS):
    if pantalla_actual=="carga":
        ventana.blit(Menu_carga,(0,0))
        ventana.blit(Enpezar_Menu,(400,592))
    elif pantalla_actual=="principal":
        ventana.blit(Menu_Principal,(0,0))
        
        posicion=pygame.mouse.get_pos()#Donde está el ratón
        if rect_botonNP.collidepoint(posicion):
            ventana.blit(Nueva_partida_rojo,(55,351))
        else:
            ventana.blit(Nueva_partida,(72,351))
        if rect_botonT.collidepoint(posicion):
            ventana.blit(Tutorial_rojo,(45,426))
        else:
            ventana.blit(Tutorial,(72,426))
        if rect_botonC.collidepoint(posicion):
            ventana.blit(Controles_rojo,(50,488))
        else:
            ventana.blit(Controles,(72,488))
        if rect_botonCr.collidepoint(posicion):
            ventana.blit(Creditos_rojo,(40,544))
        else:
            ventana.blit(Creditos,(68,544))
        if rect_botonS.collidepoint(posicion):
            ventana.blit(Salir_rojo,(45,604))
        else:
            ventana.blit(Salir,(72,604))
        
    elif pantalla_actual=="Comienzo partida":
        ventana.blit(Nueva_partidaA,(0,0))
    elif pantalla_actual=="Controles":
        ventana.blit(ControlesA,(0,0))
    elif pantalla_actual=="Tutorial":
        ventana.blit(TutorialA,(0,0))
    elif pantalla_actual=="Creditos":
        ventana.blit(CreditosA,(0,0))
    elif pantalla_actual=="Salir":
        ventana.blit(SalirA,(0,0))
        pygame.display.update()
        time.sleep(3)
        jugando=False
               
    return ventana, jugando

def eventos(jugando,pantalla_actual, rect_botonEM, rect_botonNP, rect_botonC, rect_botonT, rect_botonCr, rect_botonS):
    for evento in pygame.event.get():
            if evento.type==pygame.QUIT:#si da a la X se cierrra
                jugando=False
            if evento.type==pygame.MOUSEBUTTONDOWN:#¿Se ha hecho click?
                posicion=pygame.mouse.get_pos()#Donde se ha hecho click?
                if rect_botonEM.collidepoint(posicion):#Click dentro de la zona 
                    pantalla_actual="principal"
                elif rect_botonNP.collidepoint(posicion):
                    pantalla_actual="Comienzo partida"
                elif rect_botonC.collidepoint(posicion):
                    pantalla_actual="Controles"
                elif rect_botonT.collidepoint(posicion):
                    pantalla_actual="Tutorial"
                elif rect_botonCr.collidepoint(posicion):
                    pantalla_actual="Creditos"
                elif rect_botonS.collidepoint(posicion):
                    pantalla_actual="Salir"
            if evento.type==pygame.KEYDOWN:
                if evento.key==pygame.K_RETURN and pantalla_actual=="carga":#K_RETURN es enter
                    pantalla_actual="principal"
    
    return jugando, pantalla_actual

(Menu_carga, Menu_Principal, Enpezar_Menu, Nueva_partida, Controles, Tutorial, Creditos, Salir, 
    Nueva_partidaA, ControlesA, TutorialA, CreditosA, SalirA, Nueva_partida_rojo, Controles_rojo,
    Tutorial_rojo, Creditos_rojo, Salir_rojo, click)=imagen()

(rect_botonEM, rect_botonNP, rect_botonC, rect_botonT, 
    rect_botonCr, rect_botonS)=rect_boton(Enpezar_Menu, Nueva_partida, Controles, 
                                            Tutorial, Creditos, Salir)

pygame.mixer.music.load("Project_NorthZ/Audio_vídeos/project-zomboid-ambient-study-music-studio-quality-ost-void-monolith-gaming_c0Nzc6a7.mp3")
pygame.mixer.music.play(-1)#Se repite sin parar
click.play()
boton_pulsado=None
tienpo_pulsación=0
jugando=True
pantalla_actual="carga"#Estamos en la pantalla de carga
while jugando:
    #1.Comprobar_loque_hace_el_jugador
                
    # 2.Actualizar_el_juego
    # aquí.irá_el_movimiento,enemigos..
    jugando, pantalla_actual=eventos(jugando,pantalla_actual, rect_botonEM, 
                            rect_botonNP, rect_botonC, rect_botonT, rect_botonCr, rect_botonS)
    # 3.Dibujar_las_cosas
    # aquí.dibujaremos_imágenes_personajes_fondo...
    ventana, jugando=dibujar_pantalla(pantalla_actual, Menu_carga, Menu_Principal, Enpezar_Menu, Nueva_partida, Controles, Tutorial, 
                            Creditos, Salir, Nueva_partidaA, ControlesA, TutorialA, CreditosA, SalirA, jugando, rect_botonNP, rect_botonC, 
                            rect_botonT, rect_botonCr, rect_botonS)
    # 4. Actualizar la pantalla
    pygame.display.update()
pygame.quit()#final del juego
